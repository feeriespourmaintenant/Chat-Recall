Configs: {
	ChatRecallConfig: {
		DisplayName: Chat Recall
		HistorySize: {
			Label: Taille de l'historique
			Tooltip: Nombre de lignes envoyées qui sont gardées (de 1 à 10000).
		}
		PreviousKey: {
			Label: Touche ligne précédente
			Tooltip: Rappelle la ligne envoyée avant. Si tu la changes, le défilement du chat du jeu reste sur les flèches.
		}
		NextKey: {
			Label: Touche ligne suivante
			Tooltip: Revient en avant dans l'historique. Ne fait rien sur la ligne la plus récente.
		}
		CompleteKey: {
			Label: Touche de complétion
			Tooltip: Complète la commande en cours d'écriture après un slash, par exemple /a puis cette touche.
		}
		ShowKeyHints: {
			Label: Afficher le rappel des touches
			Tooltip: Affiche les touches de Chat Recall dans la barre de chat tant que tu n'as pas commencé une commande.
		}
		ShowCommandHelp: {
			Label: Afficher l'aide des commandes
			Tooltip: Affiche à côté du chat une fenêtre avec les paramètres et les exemples de la commande en cours d'écriture.
		}
		AlwaysSuggestPlayers: {
			Label: Toujours proposer les pseudos
			Tooltip: Après une commande, Tab propose les pseudos des joueurs connectés pour toutes les commandes, pas seulement celles dont l'aide parle de joueurs.
		}
		KeepBetweenSessions: {
			Label: Garder l'historique entre les parties
			Tooltip: Enregistre les lignes envoyées dans un fichier pour les retrouver à la prochaine partie.
		}
	}
	Help: {
		Parameters: PARAMÈTRES
		Examples: EXEMPLES
		Required: obligatoire
		KeyHistory: Historique
		KeyComplete: Compléter
		KeyScroll: Défiler le chat
		Optional: optionnel
	}
}
